# Render static site configuration for your project
# Replace repo with your GitHub repository (e.g. username/resal-store)
# Render will use this when you connect the repo to enable automatic deployments

staticSites:
  - name: resal-shop
    repo: "<REPLACE_WITH_YOUR_GITHUB_REPO>"
    branch: "main"
    buildCommand: ""
    publishPath: "."
    pullRequestPreviews:
      enabled: false
    envVars: []
